    /**
     * Update the specified resource in storage.
     */
    public function update(Request $request, Category $category)
    {
        $request->validate([
            'name' => 'required|string|max:255',
            'description' => 'nullable|string',
            'link' => 'nullable|string|max:255',
            'color' => 'required|string|regex:/^#[0-9A-F]{6}$/i',
            'parent_id' => 'nullable|exists:categories,id',
            'is_active' => 'boolean'
        ]);

        // Ambil data dari request
        $data = $request->only(['name', 'description', 'color', 'parent_id', 'is_active']);

        // Handle jika menggunakan color_hex input
        if ($request->has('color_hex') && $request->color_hex) {
            $data['color'] = strtoupper($request->color_hex);
        }

        // 1. Cegah circular reference: tidak boleh memilih diri sendiri
        if ($data['parent_id'] == $category->id) {
            return back()->withErrors(['parent_id' => 'Tidak bisa memilih diri sendiri sebagai parent.']);
        }

        // 2. Cegah memilih descendant sebagai parent
        if ($data['parent_id']) {
            $isDescendant = $this->isDescendant($category, $data['parent_id']);

            if ($isDescendant) {
                return back()->withErrors(['parent_id' => 'Tidak bisa memilih sub-kategori (descendant) sebagai parent.']);
            }
        }

        // 3. Cek apakah kategori menjadi parent dari parent-nya sendiri (circular reference lain)
        if ($category->parent_id && $category->parent_id == $data['parent_id']) {
            // Tidak ada perubahan, lanjutkan
        } else if ($category->parent_id) {
            // Jika sebelumnya punya parent dan parent berubah, perlu validasi tambahan
            $willCreateCircular = $this->willCreateCircularReference($category, $data['parent_id']);

            if ($willCreateCircular) {
                return back()->withErrors(['parent_id' => 'Perubahan ini akan membuat circular reference.']);
            }
        }

        // 4. Update slug jika nama berubah
        if ($category->name !== $data['name']) {
            $data['slug'] = $this->generateUniqueSlug($data['name'], $category->id);
        }

        // 5. Update kategori
        $category->update($data);

        // 6. Update slug untuk semua children jika parent berubah
        if ($category->wasChanged('parent_id')) {
            $this->updateChildrenSlugs($category);
        }

        return redirect()->route('categories.index')
            ->with('success', 'Kategori "' . $category->name . '" berhasil diperbarui.');
    }

    /**
     * Cek apakah suatu kategori adalah descendant dari kategori lain
     */
    private function isDescendant(Category $category, $potentialParentId)
    {
        // Jika kategori ini adalah potential parent, return false
        if ($category->id == $potentialParentId) {
            return false;
        }

        // Cek semua children secara recursive
        $children = $category->children;

        foreach ($children as $child) {
            if ($child->id == $potentialParentId) {
                return true;
            }

            if ($this->isDescendant($child, $potentialParentId)) {
                return true;
            }
        }

        return false;
    }

    /**
     * Cek apakah perubahan akan membuat circular reference
     */
    private function willCreateCircularReference(Category $category, $newParentId)
    {
        if (!$newParentId) {
            return false; // Menjadi root, tidak ada circular reference
        }

        // Jika newParent adalah category itu sendiri
        if ($newParentId == $category->id) {
            return true;
        }

        // Dapatkan newParent
        $newParent = Category::find($newParentId);

        if (!$newParent) {
            return false;
        }

        // Cek apakah category adalah ancestor dari newParent
        $current = $newParent;
        while ($current->parent_id) {
            if ($current->parent_id == $category->id) {
                return true; // Circular reference akan terjadi
            }
            $current = Category::find($current->parent_id);
        }

        return false;
    }

    /**
     * Generate unique slug
     */
    private function generateUniqueSlug($name, $exceptId = null)
    {
        $slug = \Illuminate\Support\Str::slug($name);
        $originalSlug = $slug;
        $counter = 1;

        while (Category::where('slug', $slug)
            ->when($exceptId, function ($query) use ($exceptId) {
                return $query->where('id', '!=', $exceptId);
            })
            ->exists()
        ) {
            $slug = $originalSlug . '-' . $counter;
            $counter++;
        }

        return $slug;
    }

    /**
     * Update slugs untuk semua children ketika parent slug berubah
     */
    private function updateChildrenSlugs(Category $category)
    {
        foreach ($category->children as $child) {
            // Regenerate slug untuk child berdasarkan full hierarchy
            $child->slug = $this->generateUniqueSlug($child->name, $child->id);
            $child->saveQuietly(); // Save tanpa trigger events

            // Update children secara recursive
            $this->updateChildrenSlugs($child);
        }
    }
