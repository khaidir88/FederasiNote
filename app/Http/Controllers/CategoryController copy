    /**
     * Display the specified resource.
     */


    public function show(string $parent, ?string $child = null)

    {
        // 🔹 Ambil parent kategori + children
        $parentCategory = Category::with('children')
            ->where('slug', $parent)
            ->whereNull('parent_id')
            ->firstOrFail();

        if (is_null($child)) {

            // Ambil semua child ID (jika ada)
            $childIds = $parentCategory->children->pluck('id');

            // Jika parent tidak punya sub kategori
            $articles = News::when($childIds->isNotEmpty(), function ($q) use ($childIds) {
                $q->whereIn('category_id', $childIds);
            }, function ($q) use ($parentCategory) {
                $q->where('category_id', $parentCategory->id);
            })
                ->latest()
                ->paginate(10);

            return view('news.category-parent', [
                'parent'   => $parentCategory,
                'category' => null,
                'articles' => $articles
            ]);
        }


        $childCategory = Category::where('slug', $child)
            ->where('parent_id', $parentCategory->id)
            ->firstOrFail();

        $articles = News::where('category_id', $childCategory->id)
            ->where('status', 'published')
            ->latest()
            ->paginate(3);

        return view('news.category-child', [
            'parent'   => $parentCategory,
            'category' => $childCategory,
            'articles' => $articles
        ]);
    }


